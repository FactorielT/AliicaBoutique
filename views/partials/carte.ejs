<div class="carte">
  <div class="visuel">
  <a href="/produit/<%= p.slug %>" class="photo">
    <img class="img1" loading="lazy" src="<%= imgUrl(p.image_id) %>" alt="<%= p.nom %>">
    <% if (p.image2_id) { %><img class="img2" loading="lazy" src="/img/<%= p.image2_id %>" alt=""><% } %>
    <% if (Number(p.stock) <= 0) { %><span class="etiquette rupture">RUPTURE</span>
    <% } else if (p.prix_promo) { %><span class="etiquette">-<%= Math.round((1 - p.prix_promo / p.prix_vente) * 100) %>%</span><% } %>
  </a>
  <button class="coeur" data-favori="<%= p.id %>" aria-label="Ajouter aux favoris"><svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.3"><path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/></svg></button>
  </div>
  <div>
    <div class="meta"><%= p.marque && p.marque !== 'Aliica' ? p.marque + ' · ' : '' %><%= p.categorie %><%= p.genre === 'homme' ? ', Homme' : p.genre === 'femme' ? ', Femme' : '' %></div>
    <a href="/produit/<%= p.slug %>"><h3 class="nom"><%= p.nom %></h3></a>
    <div class="prix"><%= fcfa(p.prix) %><% if (p.prix_promo) { %><del><%= fcfa(p.prix_vente) %></del><% } %></div>
  </div>
</div>
