# Connexion PostgreSQL (Render fournit DATABASE_URL automatiquement)
DATABASE_URL=postgres://aliica:aliica@localhost:5432/aliica
# Clé secrète des sessions (mettez une longue chaîne aléatoire)
SESSION_SECRET=changez-moi-par-une-longue-phrase-secrete
# Mots de passe des comptes créés au 1er démarrage
PROPRIETAIRE_PASSWORD=Aliica@2025
GERANTE_PASSWORD=Gerante@2025
# false = ne pas installer le catalogue de démonstration
SEED_DEMO=true
TZ=Africa/Abidjan
PORT=3000

# ---- Sécurité (avis Render oct. 2026) ----
# TLS vers la base : automatique (désactivé sur le réseau privé Render / localhost, vérifié sinon).
# DATABASE_SSL=true|false  · DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n..."  (autorité à approuver)
# DATABASE_SSL_NO_VERIFY=true  → INTERDIT en production
# AUTORISER_NODE_NON_CORRIGE=true → à n'utiliser qu'en dépannage, jamais en production
