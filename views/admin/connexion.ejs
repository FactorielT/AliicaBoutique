<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title>Connexion – Gestion ALIICA</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/admin.css?v=1"></head>
<body>
<div class="login">
  <div class="gauche">
    <img src="/static/img/logo.png" alt="ALIICA">
    <h1 style="font-size:28px;letter-spacing:.06em">ALIICA BOUTIQUE</h1>
    <p style="color:#a9acc6;margin-top:10px">Gestion simplifiée, boutique maîtrisée</p>
  </div>
  <div class="droite">
    <form method="post">
      <h2 style="font-size:24px">Connexion</h2>
      <p style="color:#6e7387;margin:6px 0 26px">Accédez à votre espace de gestion</p>
      <% if (erreur) { %><div class="alerte erreur"><%= erreur %></div><% } %>
      <div class="champ"><label class="l">Identifiant</label><input type="text" name="identifiant" value="<%= identifiant %>" placeholder="Entrez votre identifiant" autofocus required autocapitalize="none"></div>
      <div class="champ"><label class="l">Mot de passe</label>
        <div style="position:relative"><input type="password" name="mot_de_passe" id="mdp" placeholder="Entrez votre mot de passe" required>
        <button type="button" onclick="var m=document.getElementById('mdp');m.type=m.type==='password'?'text':'password'" style="position:absolute;right:8px;top:8px;background:none;border:0;cursor:pointer;color:#6e7387">👁</button></div></div>
      <button class="btn gros">Se connecter</button>
      <p style="text-align:center;color:#6e7387;font-size:13px;margin-top:20px">Mot de passe oublié ? Contactez la propriétaire.</p>
      <p style="text-align:center;margin-top:30px"><a href="/" class="lien">← Retour au site</a></p>
    </form>
  </div>
</div>
</body></html>
