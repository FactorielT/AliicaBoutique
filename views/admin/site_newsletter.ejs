<%- include('../partials/admin_haut') %>
<div class="barre-outils"><a class="btn sec" href="/gestion/site">← Mon site web</a><div class="droite"><a class="btn" href="/gestion/site/newsletter.csv">⬇ Exporter (Excel)</a></div></div>
<div class="carte" style="max-width:700px">
  <h2><%= abonnes.length %> abonné(s)</h2>
  <table class="t"><% abonnes.forEach(function(a){ %><tr><td><%= a.email %></td><td><%= dateFr(a.created_at) %></td>
    <td><form method="post" action="/gestion/site/newsletter/<%= a.id %>/supprimer" data-confirm="Retirer cet abonné ?"><button class="btn sec petit">×</button></form></td></tr><% }) %></table>
  <% if (!abonnes.length) { %><div class="vide">Pas encore d'abonnés.</div><% } %>
</div>
<%- include('../partials/admin_bas') %>
